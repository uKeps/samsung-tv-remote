#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["websocket-client", "yt-dlp"]
# ///
"""Control a Samsung Smart TV (2016-2017 Tizen, e.g. UN50KU6000) over the LAN.

  tv              interactive remote (arrows, enter, etc. — press ? for help)
  tv <key>...     send keys, e.g. `tv off`, `tv vol+ vol+`, `tv home`
  tv on           power the TV on (Wake-on-LAN)
  tv yt <url>     open a YouTube video on the TV
  tv netflix      open the Netflix app on the TV
  tv play <file>  play a local video file on the TV via DLNA (keep running while watching)
  tv play <url>   play a video URL on the TV (localhost links are rewritten to this PC's IP);
                  a page link (Twitch, Kick…) is opened with yt-dlp
  tv serve        web remote on port 8765 (phone/PC browser), lists videos in ~/Downloads

Settings come from the environment or ~/.config/tv-remote.env (KEY=value lines):
  TV_MAC      the TV's Wi-Fi MAC: needed to power it on, and picks the TV when there are several
  TV_IP       optional; the TV is found on the LAN when it's empty or stale
  TV_MONITOR  monitor streamed by "send a PC window" (Hyprland), default HDMI-A-1
  VIDEO_DIR   folder listed on the web remote, default ~/Downloads
  WEB_PORT    web remote port, default 8765
"""
import base64, http.server, json, mimetypes, os, pathlib, socket, subprocess, sys, termios, threading, time, tty, urllib.error, urllib.parse, urllib.request
from xml.sax.saxutils import escape
import websocket

_CONF = pathlib.Path.home() / ".config/tv-remote.env"
for _ln in _CONF.read_text().splitlines() if _CONF.is_file() else []:
    _k, _, _v = _ln.partition("=")
    if _v and not _ln.lstrip().startswith("#"):
        os.environ.setdefault(_k.strip(), _v.strip().strip('"'))
TV_IP = os.environ.get("TV_IP", "")  # last known address; found again via SSDP when DHCP changes it
TV_MAC = os.environ.get("TV_MAC", "").lower()


def find_tv():
    """Locate the TV via SSDP (the one with TV_MAC, or the first Samsung TV when it's unset).
    Returns True if found (and updates TV_IP)."""
    global TV_IP, _ws
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(my_ip()))
        s.settimeout(2)
        s.sendto(b'M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: "ssdp:discover"\r\n'
                 b'MX: 1\r\nST: urn:schemas-upnp-org:device:MediaRenderer:1\r\n\r\n', ("239.255.255.250", 1900))
        ips = set()
        try:
            while True:
                ips.add(s.recvfrom(4096)[1][0])
        except socket.timeout:
            pass
    for ip in ips:
        try:
            info = json.load(urllib.request.urlopen(f"http://{ip}:8001/api/v2/", timeout=2))
        except (OSError, ValueError):
            continue
        mac = info.get("device", {}).get("wifiMac", "").lower()
        if mac and (not TV_MAC or mac == TV_MAC):
            TV_IP, _ws = ip, None
            return True
    return False


def wake(timeout=25):
    """Power the TV on with Wake-on-LAN (works while "Power On with Mobile" is enabled on the TV)."""
    if not TV_MAC:
        raise ValueError("set TV_MAC to power the TV on (see `tv help`)")
    pkt = b"\xff" * 6 + bytes.fromhex(TV_MAC.replace(":", "")) * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for dst in ("255.255.255.255", TV_IP) if TV_IP else ("255.255.255.255",):
            for _ in range(3):
                s.sendto(pkt, (dst, 9))
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        try:
            socket.create_connection((TV_IP, 8001), timeout=1).close()
            return True
        except OSError:
            time.sleep(1)
    return find_tv()  # it may have woken up on a new DHCP address


def ensure_tv():
    """Rediscover the TV if it stopped answering at TV_IP."""
    try:
        socket.create_connection((TV_IP, 8001), timeout=1).close()
    except OSError:
        if not find_tv() and not TV_IP:
            raise ValueError("no Samsung TV found on the network (is it on? or set TV_IP)")

